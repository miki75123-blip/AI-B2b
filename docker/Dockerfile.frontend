FROM node:18-alpine

# 設置工作目錄
WORKDIR /app

# 複製 package 文件
COPY frontend/package*.json ./

# 安裝依賴
RUN npm ci --only=production

# 複製源碼
COPY frontend/ .

# 構建應用
RUN npm run build

# 使用 nginx  serving
FROM nginx:alpine
COPY --from=0 /app/dist /usr/share/nginx/html
COPY nginx/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
